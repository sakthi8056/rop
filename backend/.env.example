# ===================================================================
# ROP AI Screener - Backend Environment Configuration (Template)
# Copy this file to .env and adjust values as needed.
# ===================================================================

# Application Information
APP_NAME=ROP AI Screener
APP_VERSION=1.0.0-prototype
APP_DESCRIPTION=AI-Assisted Retinopathy of Prematurity Screening — Research Prototype
DEBUG=false

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (SQLite file path)
# DATABASE_PATH=rop_screening.db

# Storage Directories
UPLOADS_DIR=uploads
REPORTS_DIR=reports

# AI Model Configuration
MODEL_WEIGHTS_DIR=ml/weights
MODEL_WEIGHTS_FILE=rop_model.pth
MODEL_NAME=EfficientNet-B0 (ROP)
MODEL_VERSION=demo-v1.0
MODEL_INPUT_SIZE=224
MODEL_NUM_CLASSES=3

# Security & Authentication
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# Upload Constraints
MAX_UPLOAD_SIZE_MB=10

# Image Quality Pre-check Thresholds
MIN_IMAGE_RESOLUTION=200
BLUR_THRESHOLD=100.0
MIN_BRIGHTNESS=40.0
MAX_BRIGHTNESS=220.0
MIN_CONTRAST=20.0
